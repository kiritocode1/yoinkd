+static int probe_interrupt(void *opaque) { return ffmpeg_library_cancel_requested(); }
+
+// iYoinks needs stream codecs, without linking the conflicting ffprobe CLI globals.
+static int probe_media(int argc, char *argv[], char *output, size_t capacity) {
+    int offset = argc == 9 ? 2 : 0;
+    if ((argc != 7 && argc != 9) || strcmp(argv[1], "-v") || strcmp(argv[2], "error") ||
+        strcmp(argv[3 + offset], "-show_streams") || strcmp(argv[4 + offset], "-of") ||
+        strcmp(argv[5 + offset], "json"))
+        return AVERROR(EINVAL);
+    long long max_pixels = 0;
+    if (offset) {
+        char *end = NULL;
+        errno = 0;
+        max_pixels = strtoll(argv[4], &end, 10);
+        if (strcmp(argv[3], "-max_pixels") || errno || !end || *end || max_pixels <= 0 || max_pixels > 16000000)
+            return AVERROR(EINVAL);
+    }
+    AVFormatContext *context = avformat_alloc_context();
+    if (!context) return AVERROR(ENOMEM);
+    context->interrupt_callback.callback = probe_interrupt;
+    int result = avformat_open_input(&context, argv[6 + offset], NULL, NULL);
+    if (result < 0) { avformat_close_input(&context); return result; }
+    unsigned int stream_count = context->nb_streams;
+    AVDictionary **decoder_options = NULL;
+    if (max_pixels && stream_count) {
+        decoder_options = calloc(stream_count, sizeof(*decoder_options));
+        if (!decoder_options) { avformat_close_input(&context); return AVERROR(ENOMEM); }
+        for (unsigned int index = 0; result >= 0 && index < stream_count; index++) {
+            result = av_dict_set(&decoder_options[index], "max_pixels", argv[4], 0);
+            if (result >= 0) result = av_dict_set(&decoder_options[index], "threads", "1", 0);
+        }
+    }
+    if (result >= 0) result = avformat_find_stream_info(context, decoder_options);
+    if (decoder_options) {
+        for (unsigned int index = 0; index < stream_count; index++) av_dict_free(&decoder_options[index]);
+        free(decoder_options);
+    }
+    size_t used = 0;
+    if (result >= 0) {
+        int count = snprintf(output, capacity, "{\"streams\":[");
+        if (count < 0 || (size_t)count >= capacity) result = AVERROR(ENOSPC);
+        else used = (size_t)count;
+    }
+    for (unsigned int index = 0; result >= 0 && index < context->nb_streams; index++) {
+        const AVStream *stream = context->streams[index];
+        const AVCodecParameters *codec = stream->codecpar;
+        if (max_pixels && codec->codec_type == AVMEDIA_TYPE_VIDEO &&
+            (codec->width <= 0 || codec->height <= 0 || (long long)codec->width * codec->height > max_pixels)) {
+            result = AVERROR(EINVAL);
+            break;
+        }
+        const char *type = av_get_media_type_string(codec->codec_type);
+        const char *sample_format = codec->codec_type == AVMEDIA_TYPE_AUDIO ? av_get_sample_fmt_name(codec->format) : NULL;
+        int count = snprintf(output + used, capacity - used,
+                             "%s{\"codec_type\":\"%s\",\"codec_name\":\"%s\",\"width\":%d,\"height\":%d,"
+                             "\"sample_fmt\":\"%s\",\"sample_rate\":%d,\"channels\":%d,"
+                             "\"bits_per_raw_sample\":%d,\"bits_per_sample\":%d,\"bits_per_coded_sample\":%d,"
+                             "\"disposition\":{\"attached_pic\":%d}}",
+                             index ? "," : "", type ? type : "unknown", avcodec_get_name(codec->codec_id),
+                             codec->width, codec->height, sample_format ? sample_format : "unknown", codec->sample_rate,
+                             codec->ch_layout.nb_channels, codec->bits_per_raw_sample, codec->bits_per_coded_sample,
+                             codec->bits_per_coded_sample, (stream->disposition & AV_DISPOSITION_ATTACHED_PIC) != 0);
+        if (count < 0 || (size_t)count >= capacity - used) result = AVERROR(ENOSPC);
+        else used += (size_t)count;
+    }
+    if (result >= 0) {
+        int count = snprintf(output + used, capacity - used, "]}");
+        if (count < 0 || (size_t)count >= capacity - used) result = AVERROR(ENOSPC);
+    }
+    avformat_close_input(&context);
+    return result < 0 ? result : 0;
+}
