+static int probe_interrupt(void *opaque) { return ffmpeg_library_cancel_requested(); }
+
+// iYoinks needs stream codecs, without linking the conflicting ffprobe CLI globals.
+static int probe_media(int argc, char *argv[], char *output, size_t capacity) {
+    if (argc != 7 || strcmp(argv[1], "-v") || strcmp(argv[2], "error") ||
+        strcmp(argv[3], "-show_streams") || strcmp(argv[4], "-of") || strcmp(argv[5], "json"))
+        return AVERROR(EINVAL);
+    AVFormatContext *context = avformat_alloc_context();
+    if (!context) return AVERROR(ENOMEM);
+    context->interrupt_callback.callback = probe_interrupt;
+    int result = avformat_open_input(&context, argv[6], NULL, NULL);
+    if (result < 0) { avformat_close_input(&context); return result; }
+    result = avformat_find_stream_info(context, NULL);
+    size_t used = 0;
+    if (result >= 0) {
+        int count = snprintf(output, capacity, "{\"streams\":[");
+        if (count < 0 || (size_t)count >= capacity) result = AVERROR(ENOSPC);
+        else used = (size_t)count;
+    }
+    for (unsigned int index = 0; result >= 0 && index < context->nb_streams; index++) {
+        const AVCodecParameters *codec = context->streams[index]->codecpar;
+        const char *type = av_get_media_type_string(codec->codec_type);
+        int count = snprintf(output + used, capacity - used,
+                             "%s{\"codec_type\":\"%s\",\"codec_name\":\"%s\"}",
+                             index ? "," : "", type ? type : "unknown", avcodec_get_name(codec->codec_id));
+        if (count < 0 || (size_t)count >= capacity - used) result = AVERROR(ENOSPC);
+        else used += (size_t)count;
+    }
+    if (result >= 0) {
+        int count = snprintf(output + used, capacity - used, "]}");
+        if (count < 0 || (size_t)count >= capacity - used) result = AVERROR(ENOSPC);
+    }
+    avformat_close_input(&context);
+    return result < 0 ? result : 0;
+}
